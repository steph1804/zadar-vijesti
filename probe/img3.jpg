","yoast_head_json":{"title":"Otvorenje obljetni\u010dke izlo\u017ebe : \"20 godina restauratorske radionice MAS-a - BNM Portal","robots":{"index":"index","follow":"follow","max-snippet":"max-snippet:-1","max-image-preview":"max-image-preview:large","max-video-preview":"max-video-preview:-1"},"canonical":"https:\/\/bnm-portal.com\/otvorenje-obljetnicke-izlozbe-20-godina-restauratorske-radionice-mas-a\/","og_locale":"hr_HR","og_type":"article","og_title":"Otvorenje obljetni\u010dke izlo\u017ebe : \"20 godina restauratorske radionice MAS-a - BNM Portal","og_description":"Muzej anti\u010dkog stakla u Zadru\u00a0 najavljuje otvorenje obljetni\u010dke izlo\u017ebe &#8220;20 godina restauratorske radionice MAS-a&#8221; koja \u0107e se otvoriti u utorak, 24. studenoga 2026. u 12:00 sati. Ova zna\u010dajna izlo\u017eba otvara se u sklopu obilje\u017eavanja Dana grada Zadra i blagdana Sv. Kr\u0161evana te sve posjetitelje na taj dan u Muzeju o\u010dekuje slobodan ulaz i prigodnih 20 [&hellip;]","og_url":"https:\/\/bnm-portal.com\/otvorenje-obljetnicke-izlozbe-20-godina-restauratorske-radionice-mas-a\/","og_site_name":"BNM Portal","article_publisher":"https:\/\/web.facebook.com\/portal.biograd\/","article_published_time":"2026-11-20T10:31:58+00:00","article_modified_time":"2026-11-20T10:32:07+00:00","og_image":[{"width":1772,"height":1772,"url":"https:\/\/bnm-portal.com\/wp-content\/uploads\/2026\/11\/pozivnica-20-godina-2.jpg","type":"image\/jpeg"}],"author":"BNM Portal JS","twitter_card":"summary_large_image","twitter_misc":{"Napisao\/la":"BNM Portal JS","Procijenjeno vrijeme \u010ditanja":"2 minute"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/bnm-portal.com\/otvorenje-obljetnicke-izlozbe-20-godina-restauratorske-radionice-mas-a\/#article","isPartOf":{"@id":"https:\/\/bnm-portal.com\/otvorenje-obljetnicke-izlozbe-20-godina-restauratorske-radionice-mas-a\/"},"author":{"name":"BNM Portal JS","@id":"https:\/\/bnm-portal.com\/#\/sc