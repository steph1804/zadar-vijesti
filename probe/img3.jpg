/FELIKS-I-DORIS-plakat-scaled.jpg","width":1776,"height":2560},{"@type":"BreadcrumbList","@id":"https:\/\/bnm-portal.com\/noc-kazaliste-u-hnk-zadar-feliks-i-doris\/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Po\u010detna stranica","item":"https:\/\/bnm-portal.com\/"},{"@type":"ListItem","position":2,"name":"No\u0107 kazali\u0161te u HNK Zadar- Feliks i Doris"}]},{"@type":"WebSite","@id":"https:\/\/bnm-portal.com\/#website","url":"https:\/\/bnm-portal.com\/","name":"BNM Portal","description":"Najnovije lokalne vijesti i reporta\u017ee s biogradske rivijere!","potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/bnm-portal.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"hr"},{"@type":"Person","@id":"https:\/\/bnm-portal.com\/#\/schema\/person\/c0f87f8ccb28d0820188f13ea298e0fe","name":"BNM Portal JS","image":{"@type":"ImageObject","inLanguage":"hr","@id":"https:\/\/secure.gravatar.com\/avatar\/b1179b5f0f680900f8dc47abca826bd05e51ac6df39eacf014e00aefc8273873?s=96&d=mm&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/b1179b5f0f680900f8dc47abca826bd05e51ac6df39eacf014e00aefc8273873?s=96&d=mm&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/b1179b5f0f680900f8dc47abca826bd05e51ac6df39eacf014e00aefc8273873?s=96&d=mm&r=g","caption":"BNM Portal JS"},"url":"https:\/\/bnm-portal.com\/author\/jelena\/"}]}},"_links":{"self":[{"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/posts\/45279","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/users\/2"}],"replies":[{"embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/comments?post=45279"}],"version-history":[{"count":1,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/posts\/45279\/revisions"}],"predecessor-version":[{"id":45281,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/posts\/45279\/revisions\/45281"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/media\/45280"}],"wp:attachment":[{"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/media?parent=45279"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/categories?post=45279"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/tags?post=45279"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":45276,"date":"2026-11-20T11:31:58","date_gmt":"2026-11-20T10:31:58","guid":{"rendered":"https:\/\/bnm-portal.com\/?p=45276"},"modified":"2026-11-20T11:32:07","modified_gmt":"2026-11-20T10:32:07","slug":"otvorenje-obljetnicke-izlozbe-20-godina-restauratorske-radionice-mas-a","status":"publish","type":"post","link":"https:\/\/bnm-portal.com\/otvorenje-obljetnicke-izlozbe-20-godina-restauratorske-radionice-mas-a\/","title":{"rendered":"Otvorenje obljetni\u010dke izlo\u017ebe : &#8220;20 godina restauratorske radionice MAS-a"},"content":{"rendered":"<p>Muzej anti\u010dkog stakla u Zadru\u00a0 najavljuje <strong>otvorenje obljetni\u010dke izlo\u017ebe<\/strong> <strong><u>&#8220;20 godina restauratorske radionice MAS-a&#8221;<\/u> koja \u0107e se otvoriti u utorak, 24. studenoga 2026. u 12:00 sati. <\/strong><\/p>\n<p>Ova zna\u010dajna izlo\u017eba otvara se u sklopu obilje\u017eavanja Dana grada Zadra i blagdana Sv. Kr\u0161evana te sve posjetitelje na taj dan u Muzeju o\u010dekuje slobodan ulaz i prigodnih 20 % popusta na novi katalog koji prati izlo\u017ebu &#8220;20 godina restauratorske radionice u MAS-u&#8221; kao i na sve ostale suvenire i publikacije.<\/p>\n<p>Obilje\u017eavanje i proslava obljetnica prigoda su za prisje\u0107anje na va\u017ene doga\u0111aje, utemeljenje i djelovanje mnogih institucija ili primjerice istaknuta ostvarenja pojedinaca. Programi kojima su takva zbivanja popra\u0107ena donose pritom raznovrsne sadr\u017eaje \u2013 neke mnogima ve\u0107 dobro poznate, ali i one kojima se \u017eeli potaknuti daljnja kreativnost, nove ideje i stvarala\u0161tvo. Glavna je to smjernica i za obilje\u017eavanje dvadestogodi\u0161njice sistematiziranog rada na polju konzervacije i restauracije anti\u010dkog i povijesnog stakla u Zadru.<\/p>\n<p>Izlo\u017eba donosi insajderski, konzervatorsko-restauratorski prikaz vi\u0161e metoda restauracije i konzervacije provedenih u restauratorskoj radionici MAS-a, koje uklju\u010duju rad na arheolo\u0161kom staklu iz razdoblja antike\u00a0 i srednjeg vijeka, povijesnom kasnosrednjovjekovnom i novovjekovnom staklu, staklu iz podmorskih nalazi\u0161ta kao i\u00a0 suvremenim umjetni\u010dkim artefaktima od stakla.\u00a0Tako\u0111er se osvr\u0107e i na dostignu\u0107a radionice napolju inovacija u specifi\u010dnoj restauratorskoj praksi, na polju edukacije, javnih predavanja, nacionalnih i me\u0111unarodnih suradnji i konferencijskih prezentacija. Dvadeset godina restauracije stakla u Zadru pri\u010da je o strpljenju, preciznosti, predanom radu i odgovornosti prema ba\u0161tini. Kako se u prigodi 20 obljetnice inauguriraju i novi prostori restauratorske radionice u Muzeju anti\u010dkog stakla u Zadru zapo\u010dinje novo poglavlje. Ova izlo\u017eba stoga nije samo retrospektiva, ve\u0107 je i pogled prema novim mogu\u0107nostima, istra\u017eivanjima, suradnjama i izazovima u konzervaciji i restauraciji stakla.<\/p>\n<p><strong>Autori izlo\u017ebe: konzervatorica-restauratorica Ivana Matkovi\u0107 i konzervator-restaurator savjetnik dr. sc. \u0160ime Perovi\u0107\u00a0<\/strong><\/p>\n<p><strong>Trajanje izlo\u017ebe: 24. 11.2026. \u2013 31. 01. 2027.<\/strong><\/p>\n<p>&nbsp;<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Muzej anti\u010dkog stakla u Zadru\u00a0 najavljuje otvorenje obljetni\u010dke izlo\u017ebe &#8220;20 godina restauratorske radionice MAS-a&#8221; koja \u0107e se otvoriti u utorak, 24. studenoga 2026. u 12:00 sati. Ova zna\u010dajna izlo\u017eba otvara se u sklopu obilje\u017eavanja Dana grada Zadra i blagdana Sv. Kr\u0161evana te sve posjetitelje na taj dan u Muzeju o\u010dekuje slobodan ulaz i prigodnih 20 [&hellip;]<\/p>\n","protected":false},"author":2,"featured_media":45277,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_exactmetrics_skip_tracking":false,"tdm_status":"","tdm_grid_status":"","footnotes":""},"categories":[11],"tags":[],"class_list":["post-45276","post","type-post","status-publish","format-standard","has-post-thumbnail","category-kultura"],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v28.9 - https:\/\/yoast.com\/product\/yoast-seo-wordpress\/ -->\n<title>Otvorenje obljetni\u010dke izlo\u017ebe : &quot;20 godina restauratorske radionice MAS-a - BNM Portal<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/bnm-portal.com\/otvorenje-obljetnicke-izlozbe-20-godina-restauratorske-radionice-mas-a\/\" \/>\n<meta property=\"og:locale\" content=\"hr_HR\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Otvorenje obljetni\u010dke izlo\u017ebe : &quot;20 godina restauratorske radionice MAS-a - BNM Portal\" \/>\n<meta property=\"og:description\" content=\"Muzej anti\u010dkog stakla u Zadru\u00a0 najavljuje otvorenje obljetni\u010dke izlo\u017ebe &#8220;20 godina restauratorske radionice MAS-a&#8221; koja \u0107e se otvoriti u utorak, 24. studenoga 2026. u 12:00 sati. Ova zna\u010dajna izlo\u017eba otvara se u sklopu obilje\u017eavanja Dana grada Zadra i blagdana Sv. Kr\u0161evana te sve posjetitelje na taj dan u Muzeju o\u010dekuje slobodan ulaz i prigodnih 20 [&hellip;]\