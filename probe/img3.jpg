2\/media?parent=45273"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/categories?post=45273"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/tags?post=45273"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":45270,"date":"2026-11-20T10:32:58","date_gmt":"2026-11-20T09:32:58","guid":{"rendered":"https:\/\/bnm-portal.com\/?p=45270"},"modified":"2026-11-20T10:32:58","modified_gmt":"2026-11-20T09:32:58","slug":"sv-krsevan-boulder-open-2026-cetrnaesti-put-penjacki-event-godine-u-zadru","status":"publish","type":"post","link":"https:\/\/bnm-portal.com\/sv-krsevan-boulder-open-2026-cetrnaesti-put-penjacki-event-godine-u-zadru\/","title":{"rendered":"Sv. Kr\u0161evan Boulder Open 2026. \u2013 \u010detrnaesti put penja\u010dki event godine u Zadru"},"content":{"rendered":"<p>Sportsko penja\u010dki klub Paklenica i ove jeseni organizira tradicionalno natjecanje u sportskom penjanju Sv. Kr\u0161evan Boulder Open. \u010cetrnaesto izdanje odr\u017eat \u0107e se u <strong>subotu, 21. studenoga<\/strong>, u dvorani za penjanje u sklopu <strong>\u0160C Vi\u0161njik (Splitska ulica 1, drugi kat lijevo)<\/strong>.<\/p>\n<p>Ono \u0161to je po\u010delo kao lokalno klupsko natjecanje danas je jedno od najposje\u0107enijih boulder natjecanja u ovom dijelu Hrvatske i dan koji zadarska penja\u010dka zajednica s nestrpljenjem i\u0161\u010dekuje cijelu godinu. I pro\u0161le je godine nastupilo vi\u0161e od stotinu natjecatelja, uglavnom iz Istre, Rijeke, Zagreba, \u0160ibenika, Splita i susjedne Bosne i Hercegovine. Uz njih je bio i velik broj navija\u010da koji svake godine dvoranu pretvaraju u pravu penja\u010dku arenu.<\/p>\n<p>Natjecanje je otvorenog tipa i odr\u017eava se u dvije kategorije, <strong>Hobby\/Rekreacija<\/strong> i <strong>Pro<\/strong>, posebno za mu\u0161karce i \u017eene. Ove se godine natjecatelji prijavljuju <strong>online, putem aplikacije<\/strong>, a kotizacija iznosi 15 eura. Prva kvalifikacijska grupa starta u <strong>10:00<\/strong>. Svaka grupa ima sat vremena za 28 boulder problema, a najbolji se plasiraju u mu\u0161ko i \u017eensko finale, koje po\u010dinje <strong>oko 18:00<\/strong>. Smjerove i ove godine postavljaju zadarski routesetteri Mikula Ba\u0161i\u0107 i Vid Morovi\u0107,.<\/p>\n<p>Uz natjecanje cijeli dan traje dru\u017eenje uz hranu i pi\u0107e. Dan zavr\u0161ava tradicionalnim afterpartyjem u <strong>Nigdjezemskoj<\/strong>. Bend <strong>ROLO<\/strong> po\u010dinje svirati oko 22:00, a nakon njih program nastavljaju SPK DJs. Ulaz je besplatan.<\/p>\n<p>Odr\u017eavanje natjecanja omogu\u0107ili su partneri i sponzori: Elkom, Cat Stretch Studio, D Forma, MCV plin, Brlog, Fafarikula, Sun Solution, ThermoFlow i Nigdjezemska.<\/p>\n<p>Za dodatne informacije mo\u017eete se obratiti Hrvoju Grancari\u0107u na 095 923 3511 ili e-mailom na spk.paklenica@gmail.com.<\/p>\n<p>O svim novostima vezanim uz natjecanje pratite nas na dru\u0161tvenim mre\u017eama:<\/p>\n<p>Instagram: <a href=\"https:\/\/www.instagram.com\/spk.paklenica?igsh=MTNrNGo4aDlxcHIwZA==\">spk.paklenica<\/a><\/p>\n<p>Facebook: <a href=\"https:\/\/www.facebook.com\/share\/15ggLwUpew\/\">SPK Paklenica<\/a><\/p>\n<p><strong>SPORTSKO PENJA\u010cKI KLUB PAKLENICA<\/strong><\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Sportsko penja\u010dki klub Paklenica i ove jeseni organizira tradicionalno natjecanje u sportskom penjanju Sv. Kr\u0161evan Boulder Open. \u010cetrnaesto izdanje odr\u017eat \u0107e se u subotu, 21. studenoga, u dvorani za penjanje u sklopu \u0160C Vi\u0161njik (Splitska ulica 1, drugi kat lijevo). Ono \u0161to je po\u010delo kao lokalno klupsko natjecanje danas je jedno od najposje\u0107enijih boulder natjecanja [&hellip;]<\/p>\n","protected":false},"author":2,"featured_media":45271,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_exactmetrics_skip_tracking":false,"tdm_status":"","tdm_grid_status":"","footnotes":""},"categories":[13],"tags":[],"class_list":["post-45270","post","type-post","status-publish","format-standard","has-post-thumbnail","category-sport"],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v28.9 - https:\/\/yoast.com\/product\/yoast-seo-wordpress\/ -->\n<title>Sv. Kr\u0161evan Boulder Open 2026. \u2013 \u010detrnaesti put penja\u010dki event godine u Zadru - BNM Portal<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/bnm-portal.com\/sv-krsevan-boulder-open-2026-cetrnaesti-put-penjacki-event-godine-u-zadru\/\" \/>\n<meta property=\"og:locale\" content=\"hr_HR\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Sv. Kr\u0161evan Boulder Open 2026. \u2013 \u010detrnaesti put penja\u010dki event godine u Zadru - BNM Portal\" \/>\n<meta property=\"og:description\" content=\"Sportsko penja\u010dki klub Paklenica i ove jeseni organizira tradicionalno natjecanje u sportskom penjanju Sv. Kr\u0161evan Boulder Open. \u010cetrnaesto izdanje odr\u017eat \u0107e se u subotu, 21. studenoga, u dvorani za penjanje u sklopu \u0160C Vi\u0161njik (Splitska ulica 1, drugi kat lijevo). Ono \u0161to je po\u010delo kao lokalno klupsko natjecanje danas je jedno od najposje\u0107enijih boulder natjecanja [&hellip;]\" \/>\n<meta property=\"og:url\" content=\"https:\/\/bnm-portal.com\/sv-krsevan-boulder-open-2026-cetrnaesti-put-penjacki-event-godine-u-zadru\/\" \/>\n<meta property=\"og:site_name\" content=\"BNM Portal\" \/>\n<meta property=\"article:publisher\" content=\"https:\/\/web.facebook.com\/portal.biograd\/\" \/>\n<meta property=\"article:published_time\" content=\"2026-11-20T09:32:58+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/bnm-portal.com\/wp-content\/uploads\/2026\/11