rtal.com\/wp-json\/wp\/v2\/comments?post=45282"}],"version-history":[{"count":1,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/posts\/45282\/revisions"}],"predecessor-version":[{"id":45284,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/posts\/45282\/revisions\/45284"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/media\/45283"}],"wp:attachment":[{"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/media?parent=45282"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/categories?post=45282"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/bnm-portal.com\/wp-json\/wp\/v2\/tags?post=45282"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":45279,"date":"2026-11-20T11:37:45","date_gmt":"2026-11-20T10:37:45","guid":{"rendered":"https:\/\/bnm-portal.com\/?p=45279"},"modified":"2026-11-20T11:38:35","modified_gmt":"2026-11-20T10:38:35","slug":"noc-kazaliste-u-hnk-zadar-feliks-i-doris","status":"publish","type":"post","link":"https:\/\/bnm-portal.com\/noc-kazaliste-u-hnk-zadar-feliks-i-doris\/","title":{"rendered":"No\u0107 kazali\u0161te u HNK Zadar- Feliks i Doris"},"content":{"rendered":"<p><strong>U subotu, 21. studenoga,\u00a0 HNK Zadar \u0107e se pridru\u017eiti 18. No\u0107i kazali\u0161ta, koja ove godine okuplja kazali\u0161ta i druge sudionike u pedesetak gradova i mjesta diljem Hrvatske, na vi\u0161e od 80 lokacija.<\/strong><\/p>\n<p>U HNK Zadar publiku o\u010dekuje predstava \u201eFeliks i Doris\u201d, autora Billa Manhoffa u re\u017eiji Roberta Bo\u0161kovi\u0107a. Predstava po\u010dinje u 20 sati.<\/p>\n<p><strong>Izvedite dragu osobu u kazali\u0161te i provedite ve\u010der uz duhovitu i emotivnu pri\u010du dvoje ljudi u izvedbi \u017dane Bumber i Dominika Karaka\u0161i\u0107a.<\/strong><\/p>\n<p><em>U vremenu u kojem smo sve vi\u0161e okrenuti osobnim pitanjima, i u kojem je na te\u0161ko obja\u0161njiv na\u010din osobno preraslo u globalno, name\u0107e se pitanje: nije li zadatak svih nas da borbu s la\u017eljivim svijetom zapo\u010dnemo od sebe samih? Protagonisti ove predstave upravo to i \u010dine, ali uz podr\u0161ku onog drugog. Na tom putu prolaze kroz faze neprijateljstva, zaljubljenosti, odustajanja od \u017eivota pa sve do kona\u010dnog ljudskog sjedinjenja.<\/em><\/p>\n<p>Ova predstava temelji se na kultnoj \u00a0ekranizaciji filma\u00a0<em>The Owl and the Pussy cat\u00a0<\/em>(\u00a0<em>Sova i ma\u010dka\u00a0)\u00a0<\/em>s Barbrom Streisand i George Segalom u glavnim ulogama.<\/p>\n<p><em>\u00a0<\/em><strong>Cijena ulaznice iznosi 5 eura. Ulaznice su u prodaji na blagajni HNK Zadar. <\/strong><\/p>\n","protected":false},"excerpt":{"rendered":"<p>U subotu, 21. studenoga,\u00a0 HNK Zadar \u0107e se pridru\u017eiti 18. No\u0107i kazali\u0161ta, koja ove godine okuplja kazali\u0161ta i druge sudionike u pedesetak gradova i mjesta diljem Hrvatske, na vi\u0161e od 80 lokacija. U HNK Zadar publiku o\u010dekuje predstava \u201eFeliks i Doris\u201d, autora Billa Manhoffa u re\u017eiji Roberta Bo\u0161kovi\u0107a. Predstava po\u010dinje u 20 sati. Izvedite dragu [&hellip;]<\/p>\n","protected":false},"author":2,"featured_media":45280,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_exactmetrics_skip_tracking":false,"tdm_status":"","tdm_grid_status":"","footnotes":""},"categories":[11],"tags":[],"class_list":["post-45279","post","type-post","status-publish","format-standard","has-post-thumbnail","category-kultura"],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v28.9 - https:\/\/yoast.com\/product\/yoast-seo-wordpress\/ -->\n<title>No\u0107 kazali\u0161te u HNK Zadar- Feliks i Doris - BNM Portal<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/bnm-portal.com\/noc-kazaliste-