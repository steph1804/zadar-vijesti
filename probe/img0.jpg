quot;},{&quot;src&quot;:&quot;/photos/house/parking.webp&quot;,&quot;caption&quot;:&quot;Free parking behind the house&quot;}]" data-start="0" aria-label="Sole 2: 20 photos"><img class="img" src="/photos/sole-2/balcony-sea-sm.webp" alt="Sole 2: The sea from the balcony" loading="lazy"><span class="count">20 photos</span></button><div class="body"><span class="floor">First floor</span><h3>Sole 2</h3><div class="specs"><span><b>4</b> guests</span><span><b>70</b> m²</span></div><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6M3 15h18M3 18v2M21 18v2M6 10V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3M12 10V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>2 bedrooms: one with two single beds, one with a double bed</p><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9zM12 12v9M4 21h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>4 sunbeds with parasols by the sea</p><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M4.5 6.5l15 11M19.5 6.5l-15 11M9 4l3 2 3-2M9 20l3-2 3 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Cooling: air conditioning in the main living area</p><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13.5V5a2 2 0 1 1 4 0v8.5a4 4 0 1 1-4 0zM12 9v7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Heating: air conditioning, plus an electric heater in each bedroom</p><ul class="amen"><li>Sea view</li><li>Kitchen</li><li>Dishwasher</li><li>Washing machine</li><li>AC</li><li>Wi-Fi</li><li>Terrace</li><li>Parking</li></ul><div class="apt-foot"><span class="price">Price on request</span><a class="btn btn-sun btn-sm" href="#contact" data-ask="sole-2" data-guests="4">Send enquiry</a></div></div></article><article class="apt"><button type="button" class="img-btn" data-slides="[{&quot;src&quot;:&quot;/photos/sole-4/sea-view.webp&quot;,&quot;caption&quot;:&quot;The sea from the terrace&quot;},{&quot;src&quot;:&quot;/photos/sole-4/terrace-table.webp&quot;,&quot;caption&quot;:&quot;Terrace with a dining table&quot;},{&quot;src&quot;:&quot;/photos/sole-4/dining-sea-view.webp&quot;,&quot;caption&quot;:&quot;Dining area with a view of the sea&quot;},{&quot;src&quot;:&quot;/photos/sole-4/living-room-terrace.webp&quot;,&quot;caption&quot;:&quot;Living room with the terrace door&quot;},{&quot;src&quot;:&quot;/photos/sole-4/sofa.webp&quot;,&quot;caption&quot;:&quot;Corner sofa&quot;},{&quot;src&quot;:&quot;/photos/sole-4/dining-table.webp&quot;,&quot;caption&quot;:&quot;Dining table&quot;},{&quot;src&quot;:&quot;/photos/sole-4/kitchen.webp&quot;,&quot;caption&quot;:&quot;Kitchen&quot;},{&quot;src&quot;:&quot;/photos/sole-4/kitchen-2.webp&quot;,&quot;caption&quot;:&quot;Kitchen&quot;},{&quot;src&quot;:&quot;/photos/sole-4/staircase.webp&quot;,&quot;caption&quot;:&quot;Staircase and front door&quot;},{&quot;src&quot;:&quot;/photos/sole-4/hallway.webp&quot;,&quot;caption&quot;:&quot;Hallway&quot;},{&quot;src&quot;:&quot;/photos/sole-4/hallway-2.webp&quot;,&quot;caption&quot;:&quot;Hallway&quot;},{&quot;src&quot;:&quot;/photos/sole-4/double-bedroom.webp&quot;,&quot;caption&quot;:&quot;Double bedroom&quot;},{&quot;src&quot;:&quot;/photos/sole-4/double-bedroom-2.webp&quot;,&quot;caption&quot;:&quot;Double bedroom&quot;},{&quot;src&quot;:&quot;/photos/sole-4/bedroom-wardrobe.webp&quot;,&quot;caption&quot;:&quot;Bedroom with a wardrobe&quot;},{&quot;src&quot;:&quot;/photos/sole-4/double-bedroom-3.webp&quot;,&quot;caption&quot;:&quot;Double bedroom&quot;},{&quot;src&quot;:&quot;/photos/sole-4/bathroom.webp&quot;,&quot;caption&quot;:&quot;Bathroom&quot;},{&quot;src&quot;:&quot;/photos/sole-4/bathroom-sink.webp&quot;,&quot;caption&quot;:&quot;Bathroom&quot;},{&quot;src&quot;:&quot;/photos/sole-4/bathroom-2.webp&quot;,&quot;caption&quot;:&quot;Bathroom&quot;},{&quot;src&quot;:&quot;/photos/sole-4/shower.webp&quot;,&quot;caption&quot;:&quot;Shower&quot;},{&quot;src&quot;:&quot;/photos/house/parking.webp&quot;,&quot;caption&quot;:&quot;Free parking behind the house&quot;}]" data-start="0" aria-label="Sole 4: 20 photos"><img class="img" src="/photos/sole-4/sea-view-sm.webp" alt="Sole 4: The sea from the terrace" loading="lazy"><span class="count">20 photos</span></button><div class="body"><span class="floor">Second floor</span><h3>Sole 4</h3><div class="specs"><span><b>2</b> guests</span><span><b>41</b> m²</span></div><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6M3 15h18M3 18v2M21 18v2M6 10V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3M12 10V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>1 bedroom with a double bed</p><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9zM12 12v9M4 21h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>2 sunbeds with parasols by the sea</p><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M4.5 6.5l15 11M19.5 6.5l-15 11M9 4l3 2 3-2M9 20l3-2 3 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Cooling: air conditioning in the main living area</p><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13.5V5a2 2 0 1 1 4 0v8.5a4 4 0 1 1-4 0zM12 9v7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Heating: air conditioning, plus an electric heater in the bedroom</p><ul class="amen"><li>Sea view</li><li>Kitchen</li><li>Dishwasher</li><li>Washing machine</li><li>AC</li><li>Wi-Fi</li><li>Terrace</li><li>Parking</li></ul><div class="apt-foot"><span class="price">Price on request</span><a class="btn btn-sun btn-sm" href="#contact" data-ask="sole-4" data-guests="2">Send enquiry</a></div></div></article></div></div></section><section id="gallery" class="band"><div class="wrap"><div class="head"><span class="eyebrow">Gallery</span><h2>A look around</h2></div><div class="gallery"><button type="button" class="g1" data-slides="[{&quot;src&quot;:&quot;/photos/sole-1/sea-view.webp&quot;,&quot;caption&quot;:&quot;The sea from the terrace&quot;},{&quot;src&quot;:&quot;/photos/sole-1/house-from-beach.webp&quot;,&quot;caption&quot;:&quot;The house from the beach&quot;},{&quot;src&quot;:&quot;/photos/sole-1/garden-path.webp&quot;,&quot;caption&quot;:&quot;Garden path to the sea&quot;},{&quot;src&quot;:&quot;/photos/sole-1/terrace.webp&quot;,&quot;caption&quot;:&quot;Covered terrace with a dining table&quot;},{&quot;src&quot;:&quot;/photos/sole-1/living-room.webp&quot;,&quot;caption&quot;:&quot;Living room&quot;},{&quot;src&quot;:&quot;/photos/sole-2/sofa.webp&quot;,&quot;caption&quot;:&quot;Corner sofa&quot;},{&quot;src&quot;:&quot;/photos/sole-2/double-bedroom.webp&quot;,&quot;caption&quot;:&quot;Double bedroom&quot;},{&quot;src&quot;:&quot;/photos/sole-4/dining-sea-view.webp&quot;,&quot;caption&quot;:&quot;Dining area with a view of the sea&quot;}]" data-start="0"><img src="/photos/sole-1/sea-view-sm.webp" srcset="/photos/sole-1/sea-view-sm.webp 640w, /photos/sole-1/sea-view.webp 1600w" sizes="(max-width: 760px) 100vw, 640px" alt="" loading="lazy"><span>The sea from the terrace</span></button><button type="button" class="g2" data-slides="[{&quot;src&quot;:&quot;/photos/sole-1/sea-view.webp&quot;,&quot;caption&quot;:&quot;The sea from the terrace&quot;},{&quot;src&quot;:&quot;/photos/sole-1/house-from-beach.webp&quot;,&quot;caption&quot;:&quot;The house from the beach&quot;},{&quot;sr