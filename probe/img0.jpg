i","value":true},{"@type":"LocationFeatureSpecification","name":"Terrace","value":true},{"@type":"LocationFeatureSpecification","name":"Free parking","value":true},{"@type":"LocationFeatureSpecification","name":"Boat mooring","value":true},{"@type":"LocationFeatureSpecification","name":"Bed linen and towels included","value":true}],"numberOfRooms":3,"containsPlace":[{"@type":"Apartment","name":"Sole 1","description":"Ground floor, 70 m², sea-view terrace, up to 4 guests","floorSize":{"@type":"QuantitativeValue","value":70,"unitCode":"MTK"},"occupancy":{"@type":"QuantitativeValue","maxValue":4},"numberOfBedrooms":2},{"@type":"Apartment","name":"Sole 2","description":"First floor, 70 m², sea-view terrace, up to 4 guests","floorSize":{"@type":"QuantitativeValue","value":70,"unitCode":"MTK"},"occupancy":{"@type":"QuantitativeValue","maxValue":4},"numberOfBedrooms":2},{"@type":"Apartment","name":"Sole 4","description":"Second floor, 41 m², sea-view terrace, up to 2 guests","floorSize":{"@type":"QuantitativeValue","value":41,"unitCode":"MTK"},"occupancy":{"@type":"QuantitativeValue","maxValue":2},"numberOfBedrooms":1}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I bring my pet?","acceptedAnswer":{"@type":"Answer","text":"Unfortunately not. We do not accept pets."}},{"@type":"Question","name":"What is the beach like?","acceptedAnswer":{"@type":"Answer","text":"The sea is 10 m from the house. The beach is sandy in the shallows; further out, the seabed is covered with seagrass and stones."}},{"@type":"Question","name":"How far are shops and restaurants?","acceptedAnswer":{"@type":"Answer","text":"The nearest pizzeria is 200 m away, a shop 900 m, a restaurant 1 km and a large shopping centre 2.5 km. Biograd na Moru is 5 km away."}},{"@type":"Question","name":"Are bed linen and towels included?","acceptedAnswer":{"@type":"Answer","text":"Yes, bed linen and towels are included."}},{"@type":"Question","name":"What are the check-in and check-out times?","acceptedAnswer":{"@type":"Answer","text":"Check-in is from 14:00 and check-out is by 10:00."}},{"@type":"Question","name":"How do I book and pay?","acceptedAnswer":{"@type":"Answer","text":"Send us an enquiry with your dates. A 30% deposit by bank transfer or Revolut confirms the booking; the rest is paid in cash. Tourist tax is included in the price."}},{"@type":"Question","name":"Is there parking?","acceptedAnswer":{"@type":"Answer","text":"Yes. Each apartment has one free parking space in the courtyard."}},{"@type":"Question","name":"Can I bring my boat?","acceptedAnswer":{"@type":"Answer","text":"Yes. There is a boat mooring in front of the house, and parking for boat trailers 50 m away."}}]}]</script><link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png"><link rel="icon" href="/icon-48.png" sizes="48x48" type="image/png"><link rel="icon" href="/icon-96.png" sizes="96x96" type="image/png"><link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><style>.flatpickr-calendar{opacity:0;text-align:center;visibility:hidden;-webkit-box-sizing:border-box;box-sizing:border-box;-ms-touch-action:manipulation;touch-action:manipulation;direction:ltr;background:#fff;border:0;border-radius:5px;width:307.875px;padding:0;font-size:14px;line-height:24px;-webkit-animation:none;animation:none;display:none;position:absolute;-webkit-box-shadow:1px 0 #e6e6e6,-1px 0 #e6e6e6,0 1px #e6e6e6,0 -1px #e6e6e6,0 3px 13px #00000014;box-shadow:1px 0 #e6e6e6,-1px 0 #e6e6e6,0 1px #e6e6e6,0 -1px #e6e6e6,0 3px 13px #00000014}.flatpickr-calendar.open,.flatpickr-calendar.inline{opacity:1;visibility:visible;max-height:640px}.flatpickr-calendar.open{z-index:99999;display:inline-block}.flatpickr-calendar.animate.open{-webkit-animation:.3s cubic-bezier(.23,1,.32,1) fpFadeInDown;animation:.3s cubic-bezier(.23,1,.32,1) fpFadeInDown}.flatpickr-ca