nt-size:14px}.hero p.direct-badge{text-shadow:none;backdrop-filter:blur(4px);background:#00000059;border:1px solid #ffffff59;border-radius:999px;align-items:center;gap:8px;margin:-12px 0 24px;padding:7px 14px;font-size:15px;font-weight:600;display:inline-flex}.direct-badge svg{width:18px;height:18px;color:var(--sun);flex:none}.head p.direct-note{border-left:4px solid var(--sun);background:var(--paper);color:var(--ink);border-radius:0 8px 8px 0;margin-top:14px;padding:12px 16px}.faq-wrap{max-width:860px}.faq{gap:10px;display:grid}.faq details{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:0 18px}.faq summary{cursor:pointer;padding:16px 28px 16px 0;font-weight:600;list-style:none;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";color:var(--sea);font-size:22px;transition:transform .2s;position:absolute;top:12px;right:0}.faq details[open] summary:after{transform:rotate(45deg)}.faq details p{color:var(--muted);margin:0 0 16px}.reviews{grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;display:grid}.review{background:var(--paper);border:1px solid var(--line);border-radius:12px;flex-direction:column;justify-content:space-between;gap:16px;margin:0;padding:22px;display:flex}.review blockquote{margin:0;font-size:16px;line-height:1.55}.review figcaption{color:var(--muted);font-size:14px}.reviews-more{margin:20px 0 0}.reviews-top{flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px 24px;margin-bottom:32px;display:flex}.reviews-top .head{margin-bottom:0}.bk-badge{background:var(--paper);border:1px solid var(--line);color:var(--ink);border-radius:12px;align-items:center;gap:12px;padding:12px 14px 12px 18px;text-decoration:none;display:inline-flex}.bk-badge:hover{border-color:#003b95}.bk-text{flex-direction:column;align-items:flex-end;line-height:1.25;display:flex}.bk-text b{font-size:18px;font-weight:600}.bk-text small{color:var(--muted);font-size:13px}.bk-score{color:#fff;background:#003b95;border-radius:8px 8px 8px 0;place-items:center;min-width:46px;height:46px;padding:0 6px;font-size:19px;font-weight:700;display:grid}.reviews-more a{color:var(--sea);font-weight:500}.contact-band{background:var(--sea-deep);color:#eef5f6;border-color:#0000}.contact-band .eyebrow{color:var(--sun)}.contact-band .head p{color:#eef5f6c7}.contact-band .head p.direct-note{color:#eef5f6;background:#ffffff14}.contact-band .direct div{border-color:#ffffff26}.contact-band .direct span{color:#eef5f6b3}.contact-band .enquiry-card{color:var(--ink);box-shadow:0 24px 60px -16px #0000008c}.enquiry-card{background:var(--paper);border-top:6px solid var(--sun);border-radius:16px;padding:28px;box-shadow:0 18px 50px -12px #083c4859}.enquiry-title{font-family:var(--display);align-items:center;gap:10px;margin:0 0 4px;font-size:24px;display:flex}.enquiry-title svg{width:26px;height:26px;color:var(--sea);flex:none}.enquiry-card input,.enquiry-card select,.enquiry-card textarea{background:var(--stone)}.enquiry-card input:focus,.enquiry-card select:focus,.enquiry-card textarea:focus{outline:2px solid var(--sea);outline-offset:1px}.enquiry-card button[type=submit]{justify-content:center;justify-self:stretch;padding:16px 22px;font-size:18px;box-shadow:0 6px 18px -6px #f2b526cc}@media (width<=520px){.enquiry-card{padding:20px}}.prose img[src$=booking-9-6\.jpg]{width:100%;max-width:min(480px,100%);margin-inline:auto}
</style></head><body><header><div class="wrap nav"><a class="logo" href="/"><picture><source srcset="/logo/sole-white.svg" media="(prefers-color-scheme: dark)"><img src="/logo/sole-color.svg" alt="Sole Apartments, Turanj Croatia" width="91" height="44"></picture></a><button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Menu"><span></span><span></span><span></span></button><nav class="links" id="menu"><a href="/#apartments">Apartments</a><a href="/#gallery">Gallery</a><a href="/#location">Location</a><a href="/blog/">Blog</a><a href="/#contact">Contact</a></nav><details class="lang"><summary aria-label="EN, Language">EN</summary><div class="lang-menu"><a href="/" hreflang="en" lang="en" aria-current="page">English</a><a href="/hr/" hreflang="hr" lang="hr">Hrvatski</a><a href="/de/" hreflang="de" lang="de">Deutsch</a><a href="/it/" hreflang="it" lang="it">Italiano</a><a href="/fr/" hreflang="fr" lang="fr">Français</a><a href="/pl/" hreflang="pl" lang="pl">Polski</a><a href="/hu/" hreflang="hu" lang="hu">Magyar</a><a href="/cs/" hreflang="cs" lang="cs">Čeština</a><a href="/sk/" hreflang="sk" lang="sk">Slovenčina</a><a href="/ro/" hreflang="ro" lang="ro">Română</a><a href="/sl/" hreflang="sl" lang="sl">Slovenščina</a><a href="/sv/" hreflang="sv" lang="sv">Svenska</a></div></details></div></header><script type="module">var e=document.querySelector(`details.lang`);document.addEventListener(`click`,t=>{e.contains(t.target)||(e.open=!1)}),e.querySelectorAll(`a[hreflang]`).forEach(e=>{e.addEventListener(`click`,()=>{try{localStorage.setItem(`sole-lang`,e.hreflang)}catch{}location.hash&&!e.hash&&(e.hash=location.hash)})});var t=document.querySelector(`.menu-btn`),n=document.querySelector(`header`),r=e=>{n.classList.toggle(`open`,e),t.setAttribute(`aria-expanded`,String(e))};t.addEventListener(`click`,()=>r(!n.classList.contains(`open`))),document.querySelectorAll(`#menu a`).forEach(e=>e.addEventListener(`click`,()=>r(!1)));</script><main><div class="hero" id="top"><img class="hero-img" src="/photos/sole-1/sea-view.webp" srcset="/photos/sole-1/sea-view-sm.webp 640w, /photos/sole-1/sea-view-md.webp 1080w, /photos/sole-1/sea-view.webp 1600w" sizes="100vw" alt="" fetchpriority="high" decoding="async"><div class="wrap"><span class="eyebrow">Turanj · Zadar region · Croatia</span><h1>Wake up 10 metres from the sea</h1><p>Three apartments in the first row by the Adriatic, each with its own sea-view terrace and free parking in the courtyard.</p><p class="direct-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Best price when you book directly</p><div class="btns"><a class="btn btn-sun" href="#contact">Ask for availability</a><a class="btn btn-ghost" href="#apartments">See the apartments</a></div></div></div><div class="facts"><div class="wrap"><div class="fact"><b>10 m</b><span>to the sea, first row</span></div><div class="fact"><b>3 of 3</b><span>apartments face the sea</span></div><div class="fact"><b>Free</b><span>parking, plus boat mooring in front</span></div><a class="fact rating" href="https://www.booking.com/hotel/hr/sole-apartments-turanj.html" target="_blank" rel="noopener"><b>9.6<small>/10</small></b><span>84 guest reviews on Booking.com</span></a></div></div><section id="apartments"><div class="wrap"><div class="head"><span class="eyebrow">Apartments</span><h2>Pick your floor</h2><p>Every apartment has a kitchen with a dishwasher, a washing machine, air conditioning, Wi-Fi, a terrace facing the sea and one parking space.</p></div><div class="apts"><article class="apt"><button type="button" class="img-btn" data-slides="[{&quot;src&quot;:&quot;/photos/sole-1/terrace.webp&quot;,&quot;caption&quot;:&quot;Covered terrace with a dining table&quot;},{&quot;src&quot;:&quot;/photos/sole-1/sea-view.webp&quot;,&quot;caption&quot;:&quot;The sea from the terrace&quot;},{&quot;src&quot;:&quot;/photos/sole-1/living-room.webp&quot;,&quot;caption&quot;:&quot;Living room&quot;},{&quot;src&quot;:&quot;/photos/sole-1/sofa.webp&quot;,&quot;caption&quot;:&quot;Corner sofa&quot;},{&quot;src&quot;:&quot;/photos/sole-1/living-room-tv.webp&quot;,&quot;caption&quot;:&quot;Living room with TV&quot;},{&quot;src&quot;:&quot;/photos/sole-1/dining-table.webp&quot;,&quot;caption&quot;:&quot;Dining table&quot;},{&quot;src&quot;:&quot;/photos/sole-1/dining-area.webp&quot;,&quot;caption&quot;:&quot;Dining area&quot;},{&quot;src&quot;:&quot;/photos/sole-1/dining-kitchen.webp&quot;,&quot;caption&quot;:&quot;Dining area and kitchen&quot;},{&quot;src&quot;:&quot;/photos/sole-1/kitchen.webp&quot;,&quot;caption&quot;:&quot;Kitchen&quot;},{&quot;src&quot;:&quot;/photos/sole-1/kitchen-2.webp&quot;,&quot;caption&quot;:&quot;Kitchen&quot;},{&quot;src&quot;:&quot;/photos/sole-1/double-bedroom.webp&quot;,&quot;caption&quot;:&quot;Double bedroom&quot;},{&quot;src&quot;:&quot;/photos/sole-1/twin-bedroom.webp&quot;,&quot;caption&quot;:&quot;Twin bedroom&quot;},{&quot;src&quot;:&quot;/photos/sole-1/bathroom.webp&quot;,&quot;caption&quot;:&quot;Bathroom&quot;},{&quot;src&quot;:&quot;/photos/sole-1/bathroom-2.webp&quot;,&quot;caption&quot;:&quot;Bathroom&quot;},{&quot;src&quot;:&quot;/photos/sole-1/washing-machine.webp&quot;,&quot;caption&quot;:&quot;Washing machine&quot;},{&quot;src&quot;:&quot;/photos/sole-1/garden-path.webp&quot;,&quot;caption&quot;:&quot;Garden path to the sea&quot;},{&quot;src&quot;:&quot;/photos/sole-1/house-from-garden.webp&quot;,&quot;caption&quot;:&quot;The house from the garden&quot;},{&quot;src&quot;:&quot;/photos/sole-1/house-from-beach.webp&quot;,&quot;caption&quot;:&quot;The house from the beach&quot;},{&quot;src&quot;:&quot;/photos/house/parking.webp&quot;,&quot;caption&quot;:&quot;Free parking behind the house&quot;}]" data-start="0" aria-label="Sole 1: 19 photos"><img class="img" src="/photos/sole-1/terrace-sm.webp" alt="Sole 1: Covered terrace with a dining table" loading="lazy"><span class="count">19 photos</span></button><div class="body"><span class="floor">Ground floor</span><h3>Sole 1</h3><div class="specs"><span><b>4</b> guests</span><span><b>70</b> m²</span></div><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6M3 15h18M3 18v2M21 18v2M6 10V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3M12 10V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>2 bedrooms: one with two single beds, one with a double bed</p><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9zM12 12v9M4 21h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>4 sunbeds with parasols by the sea</p><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M4.5 6.5l15 11M19.5 6.5l-15 11M9 4l3 2 3-2M9 20l3-2 3 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Cooling: air conditioning in the main living area</p><p class="beds"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13.5V5a2 2 0 1 1 4 0v8.5a4 4 0 1 1-4 0zM12 9v7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Heating: air conditioning, plus an electric heater in each bedroom</p><ul class="amen"><li>Sea view</li><li>Kitchen</li><li>Dishwasher</li><li>Washing machine</li><li>AC</li><li>Wi-Fi</li><li>Terrace</li><li>Parking</li></ul><div class="apt-foot"><span class="price">Price on request</span><a class="btn btn-sun btn-sm" href="#contact" data-ask="sole-1" data-guests="4">Send enquiry</a></div></div></article><article class="apt"><button type="button" class="img-btn" data-slides="[{&quot;src&quot;:&quot;/photos/sole-2/balcony-sea.webp&quot;,&quot;caption&quot;:&