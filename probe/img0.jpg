 725 789 725 726V721C725 658 656 643 467 627C242 609 57 532 57 295C57 85 208 -18 419 -18ZM524 207C440 207 383 246 383 311C383 380 449 418 541 432C626 446 691 459 728 476V380C728 276 639 207 524 207Z"/></g><circle class="dot" cx="6.5" cy="16.8" r="6.2"/><g class="c"><path transform="translate(155.7 52) scale(0.0146484375 -0.0146484375)" d="M250 -18C345 -18 420 57 420 152C420 246 345 322 250 322C156 322 81 246 81 152C81 57 156 -18 250 -18Z"/><path transform="translate(163.1 52) scale(0.0146484375 -0.0146484375)" d="M588 -24C869 -24 1071 153 1084 397H797C778 286 711 214 592 214C444 214 355 335 355 527C355 720 443 842 592 842C710 842 784 769 799 661H1084C1065 907 866 1080 588 1080C271 1080 58 854 58 527C58 200 270 -24 588 -24Z"/><path transform="translate(179.7 52) scale(0.0146484375 -0.0146484375)" d="M399 1490H104V0H399Z"/><path transform="translate(187.1 52) scale(0.0146484375 -0.0146484375)" d="M104 0H399V1056H104ZM251 1189C348 1189 419 1256 419 1346C419 1436 348 1503 251 1503C154 1503 83 1436 83 1346C83 1256 154 1189 251 1189Z"/><path transform="translate(194.5 52) scale(0.0146484375 -0.0146484375)" d="M588 -24C869 -24 1071 153 1084 397H797C778 286 711 214 592 214C444 214 355 335 355 527C355 720 443 842 592 842C710 842 784 769 799 661H1084C1065 907 866 1080 588 1080C271 1080 58 854 58 527C58 200 270 -24 588 -24Z"/><path transform="translate(211.1 52) scale(0.0146484375 -0.0146484375)" d="M104 0H399V335L484 429L795 0H1140L705 598L1118 1056H772L402 652H399V1490H104Z"/></g></svg></a>
    <input class="search" id="q" type="search" placeholder="Pretraži vijesti…" aria-label="Pretraži vijesti">
