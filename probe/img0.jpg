 null, "errors": []}], "updated": "2026-11-28T11:48:40.562545+00:00"};
const PAGE = null;
const BASE = "./";
const fmt = new Intl.DateTimeFormat("hr-HR", { day: "numeric", month: "numeric", hour: "2-digit", minute: "2-digit" });
const hmFmt = new Intl.DateTimeFormat("hr-HR", { hour: "2-digit", minute: "2-digit" });
const STEP = 24;
const state = { topic: PAGE || "Sve", source: "", q: "", shown: STEP };

function el(tag, attrs = {}, ...kids) {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) if (v != null) e.setAttribute(k, v);
  for (const k of kids) if (k != null && k !== "") e.append(k);
  return e;
}
const fold = s => s.toLocaleLowerCase("hr").normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/đ/g, "d");

function ago(d) {
  const min = Math.round((Date.now() - new Date(d)) / 60000);
  if (min < 1) return "upravo";
  if (min < 60) return `prije ${min} min`;
  if (min < 24 * 60) return `prije ${Math.round(min / 60)} h`;
  return fmt.format(new Date(d));
}

function matches(a, ignoreTopic) {
  if (!ignoreTopic && state.topic !== "Sve" && !(a.topics || []).includes(state.topic)) return false;
  if (state.source && a.source !== state.source) return false;
  if (state.q) {
    const hay = fold(a.title + " " + a.summary + " " + a.source);
    if (!fold(state.q).split(/\s+/).every(w => hay.includes(w))) return false;
  }
  return true;
}

// Kad je odabran portal, spojena kartica prikazuje članak baš s tog portala,
// a ostali portali idu u "Piše i".
function visible() {
  if (!state.source) return DATA.articles;
  return DATA.articles.map(a => {
    if (a.source === state.source || !a.also) return a;
    const own = a.also.find(x => x.source === state.source);
    if (!own || !own.title) return a;
    const others = [a, ...a.also.filter(x => x !== own)].map(x => ({ source: x.source, link: x.link }));
    return { ...own, topics: a.topics, also: others };
  });
}

// --- Rubrike: svaka ima svoju stranicu, a klik je prebacuje bez ponovnog učitavanja ---
const pageUrl = t => BASE + (t === "Sve" ? "" : DATA.pages[t] + "/");
const HEADINGS = { Sve: "Vijesti iz Zadra i županije", Zadar: "Vijesti iz Zadra", "Županija": "Vijesti iz županije",
  Otoci: "Vijesti sa zadarskih otoka", Sport: "Zadarski sport" };

function setTopic(t, push) {
  state.topic = t; state.shown = STEP;
  if (push) history.pushState({ topic: t }, "", new URL(pageUrl(t), location.href).pathname);
  document.title = t === "Sve" ? "idassa.click – vijesti iz Zadra" : `${t} – idassa.click`;
  setH1(HEADINGS[t] || t);
  render();
  window.scrollTo({ top: 0 });
}
addEventListener("popstate", e => setTopic((e.state && e.state.topic) || PAGE || "Sve", false));

function nav() {
  const box = document.getElementById("nav");
  const sel = document.getElementById("source");
  for (const c of [...box.querySelectorAll(".chip")]) c.remove();
  const pool = visible().filter(a => matches(a, true));
  for (const name of ["Sve", ...DATA.topics]) {
    const n = name === "Sve" ? pool.length : pool.filter(a => (a.topics || []).includes(name)).length;
    const a = el("a", { class: "chip", href: pageUrl(name), "aria-current": name === state.topic ? "page" : null },
      name === "Sve" ? "Sve vijesti" : name, el("span", { class: "n" }, String(n)));
    a.onclick = e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; e.preventDefault(); setTopic(name, true); };
    box.insertBefore(a, sel);
  }
}

// Rezanje slike tako da prepoznata lica budu u sredini kadra (i cijela, ako stanu).
// Bez prepoznatih lica: gornja trećina, gdje su lica najčešće.
function frame(img) {
  const bw = img.clientWidth, bh = img.clientHeight, iw = img.naturalWidth, ih = img.naturalHeight;
  if (!img.dataset.face || !iw || !bw || !bh) { img.style.objectPosition = "50% 30%"; return; }
  const [t, b, l, r] = img.dataset.face.split(",").map(Number);
  const scale = Math.max(bw / iw, bh / ih);
  const axis = (from, to, shown, full) => {
    const extra = full - shown;
    if (extra <= 0) return 50;
    const a = from / 100 * full, z = to / 100 * full;
    // Ako lica ne stanu cijela, prednost ima gornji dio (oči), ne brada.
    let off = z - a > shown ? a : (a + z) / 2 - shown / 2;
    return Math.min(Math.max(off, 0), extra) / extra * 100;
  };
  img.style.objectPosition = `${axis(l, r, bw, iw * scale)}% ${axis(t, b, bh, ih * scale)}%`;
}
let resizeTimer;
addEventListener("resize", () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(() => document.querySelectorAll("article img").forEach(frame), 150);
});

// Ikona portala (favicon preko Googleove usluge; ako je nema, ikona se sakrije).
function favicon(link) {
  let host = "";
  try { host = new URL(link).hostname; } catch (e) { return null; }
  const i = el("img", { class: "fav", alt: "", loading: "lazy", src: `https://www.google.com/s2/favicons?domain=${host}&sz=32` });
  i.onerror = () => i.remove();
  return i;
}

// Rubrika za boju kartice: prva osim Zadra (Zadar je zadana plava).
const topicOf = a => (a.topics || []).find(t => t !== "Zadar") || null;

function card(a, kind) {
  // Vlastiti članci (izvor idassa.click) otvaraju se u istom prozoru, ostali na portalu u novom.
  const link = a.own ? { href: a.link } : { href: a.link, target: "_blank", rel: "noopener" };
  const t = topicOf(a);
  const c = el("article", { class: kind ? "ov " + kind : (a.image ? null : "noimg"), "data-t": t });
  if (a.image) {
    const img = el("img", { src: a.image, alt: "", loading: kind ? "eager" : "lazy", referrerpolicy: "no-referrer" });
    img.dataset.face = a.face ? a.face.join(",") : "";
    img.onload = () => frame(img);
    img.onerror = () => { img.parentElement.remove(); c.classList.remove("ov"); c.classList.add("noimg"); };
    c.append(el("a", { ...link, class: "img", tabindex: "-1", "aria-hidden": "true" }, img));
  }
  let also = null;
  if (a.also && a.also.length) {
    also = el("div", { class: "also" }, "Piše i: ");
    a.also.forEach((x, i) => {
      if (i) also.append(", ");
      also.append(el("a", { href: x.link, target: "_blank", rel: "noopener" }, x.source));
    });
  }
  const topic = (state.topic === "Sve" || kind) && t;
  c.append(el("div", { class: "body" },
    el("div", { class: "meta" }, el("span", { class: "src" }, favicon(a.link), el("b", {}, a.source)),
      el("time", { datetime: a.date, title: fmt.format(new Date(a.date)) }, ago(a.date)),
      a.promo ? el("span", { class: "promo", title: "Promotivni sadržaj" }, "Promo") : null,
      topic && !a.promo ? el("span", { class: "tag", "data-t": topic }, topic) : null),
    el("h2", {}, el("a", link, a.title)),
    a.summary && !fold(a.summary).startsWith(fold(a.title)) ? el("p", {}, a.summary) : null,
    also,
    el("div", { class: "foot" },
      el("a", { ...link, class: "more" }, a.own ? "Pročitaj članak →" : `Pročitaj na ${a.source} →`),
      shareBtn(a))));
  return c;
}

function list() {
  const main = document.getElementById("list");
  main.textContent = "";
  const items = visible().filter(a => matches(a));
  if (!items.length) { main.append(el("div", { class: "empty" }, "Nema vijesti za odabrane filtre.")); return; }
  // Naslovne priče: do tri najnovije vijesti s fotografijom (među prvih osam).
  // Vlastiti članci sa stalnom pozicijom ("position" u uređivaču) ne idu po datumu.
  const fixed = state.q ? [] : items.filter(a => a.position > 0).sort((a, b) => a.position - b.position);
  const rest = items.filter(a => !fixed.includes(a));
  let hero = state.q ? [] : rest.slice(0, 8).filter(a => a.image).slice(0, 3);
  let order = rest.filter(a => !hero.includes(a));
  if (fixed.length) {
    const all = [...hero, ...order];
    fixed.forEach(a => all.splice(Math.min(a.position - 1, all.length), 0, a));
    const n = hero.length;
    hero = all.slice(0, n);
    order = all.slice(n);
    if (hero.some(a => !a.image)) { order = [...hero.filter(a => !a.image), ...order]; hero = hero.filter(a => a.image); }
  }
  if (hero.length) {
    const box = el("section", { class: "hero" + (hero.length === 1 ? " one" : hero.length === 2 ? " two" : ""), "aria-label": "Izdvojeno" });
    hero.forEach((a, i) => box.append(card(a, i ? "small" : "big")));
    main.append(box, el("div", { class: "sec" }, "Najnovije"));
  }
  // Na naslovnici (bez pretrage i odabranog portala) između kartica idu vrpce rubrika.
  const strips = state.topic === "Sve" && !state.q && !state.source ? { 8: "Sport", 17: "Otoci", 26: "Županija" } : {};
  order.slice(0, state.shown).forEach((a, i) => {
    main.append(card(a));
    if (i === 6 && !state.q) main.append(newsletter());
    if (strips[i]) main.append(strip(strips[i], [...hero, ...order.slice(0, i + 1)]));
    if (i === 3 && state.topic === "Sve" && !state.q && !state.source) main.append(videoStrip());
    if (i === 12 && state.topic === "Sve" && !state.q && !state.source) main.append(retroStrip());
  });
  if (order.length > state.shown) {
    const b = el("button", { class: "load", type: "button" }, `Prikaži još (${order.length - state.shown})`);
    b.onclick = () => { state.shown += STEP; list(); };
    main.append(b);
  }
}

function strip(t, skip) {
  const items = visible().filter(a => (a.topics || []).includes(t) && a.image && !skip.includes(a)).slice(0, 10);
  if (items.length < 3) return "";
  const all = el("a", { href: pageUrl(t) }, "Sve vijesti →");
  all.onclick = e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; e.preventDefault(); setTopic(t, true); };
  const row = el("div", { class: "row" });
  items.forEach(a => row.append(card(a)));
  return el("section", { class: "strip", "data-t": t, "aria-label": t },
    el("header", {}, el("h3", {}, HEADINGS[t] || t), all), row);
}

// Vrpca videa s YouTubea (naslovi o Zadru i županiji iz zadnja tri dana)
function videoStrip() {
  const v = DATA.info && DATA.info.videos && DATA.info.videos.items;
  if (!v || v.length < 2) return "";
  const row = el("div", { class: "row" });
  for (const x of v) {
    const link = { href: x.link, target: "_blank", rel: "noopener" };
    const img = el("img", { src: x.image, alt: "", loading: "lazy", referrerpolicy: "no-referrer" });
    row.append(el("article", { class: "vid" },
      el("a", { ...link, class: "img", tabindex: "-1", "aria-hidden": "true" }, img),
      el("div", { class: "body" },
        el("div", { class: "meta" }, el("b", {}, x.channel), el("time", { datetime: x.date }, ago(x.date))),
        el("h2", {}, el("a", link, x.title)))));
  }
  return el("section", { class: "strip", "data-t": "Video", "aria-label": "Video" },
    el("header", {}, el("h3", {}, "Video iz Zadra"),
      el("a", { href: "https://www.youtube.com/results?search_query=Zadar&sp=CAI%253D", target: "_blank", rel: "noopener" }, "YouTube →")), row);
}

// Vrpca bloga Retro Zadar: sve objave o povijesti grada
function retroStrip() {
  const v = DATA.info && DATA.info.retro;
  if (!v || v.length < 2) return "";
  const row = el("div", { class: "row" });
  for (const x of v) {
    const link = { href: x.link, target: "_blank", rel: "noopener" };
    const img = x.image ? el("img", { src: x.image, alt: "", loading: "lazy", referrerpolicy: "no-referrer" }) : "";
    row.append(el("article", { class: "retro" },
      el("a", { ...link, class: "img", tabindex: "-1", "aria-hidden": "true" }, img),
      el("div", { class: "body" },
        el("div", { class: "meta" }, el("b", {}, "Retro Zadar")),
        el("h2", {}, el("a", link, x.title)))));
  }
  return el("section", { class: "strip", "data-t": "Retro", "aria-label": "Retro Zadar" },
    el("header", {}, el("h3", {}, `Retro Zadar · povijest grada (${v.length})`),
      el("a", { href: "https://www.retrozadar.com/blog", target: "_blank", rel: "noopener" }, "Svi članci →")), row);
}

// Traka "Upravo" i brojke u zaglavlju
// naslov s naglaskom na mjestu (Zadra, županije, otoka...)
function setH1(text) {
  const h1 = document.getElementById("h1"), m = text.match(/^(.*?)(Zadra|županije|otoka|sport)(.*)$/i);
  h1.textContent = "";
  if (!m) { h1.textContent = text; return; }
  h1.append(m[1], el("span", { class: "hl" }, m[2]), m[3]);
}

function masthead() {
  setH1(document.getElementById("h1").textContent);
  const now = Date.now(), day = 24 * 3600 * 1000;
  const today = DATA.articles.filter(a => now - new Date(a.date) < day).length;
  const sources = new Set(DATA.articles.flatMap(a => [a.source, ...(a.also || []).map(x => x.source)])).size;
  const stats = document.getElementById("stats");
  const stat = (n, label, id) => el("div", { class: "stat", id }, el("b", {}, n), el("span", {}, label));
  stats.append(stat(String(today), "vijesti danas"), stat(String(sources), "izvora"), stat("–", "Zadar sada", "now"));
  const tr = document.getElementById("tr");
  const latest = DATA.articles.slice(0, 12);
  if (!latest.length) return;
  for (const copy of [0, 1]) for (const a of latest) {
    const x = el("a", { href: a.link, target: "_blank", rel: "noopener", "aria-hidden": copy ? "true" : null, tabindex: copy ? "-1" : null },
      el("time", { datetime: a.date }, hmFmt.format(new Date(a.date))), a.title);
    tr.append(x);
  }
  document.getElementById("ticker").hidden = false;
}

function footer() {
  const ul = document.getElementById("f-sources");
  const sites = DATA.sites || {};
  const has = new Set(DATA.articles.flatMap(a => [a.source, ...(a.also || []).map(x => x.source)]));
  const names = DATA.sources.filter(n => has.has(n)).sort((a, b) => a.localeCompare(b, "hr"));
  for (const n of names) ul.append(el("li", {}, sites[n] ? el("a", { href: sites[n], target: "_blank", rel: "noopener" }, n) : n));
  document.getElementById("f-n").textContent = DATA.articles.length;
  document.getElementById("f-s").textContent = names.length;
  document.getElementById("f-y").textContent = new Date().getFullYear();
}

function render() { nav(); list(); }

function setupTools() {
  const sel = el("select", { id: "source", "aria-label": "Izvor" });
  sel.append(el("option", { value: "" }, "Svi izvori"));
  // U izborniku su samo portali koji trenutno imaju barem jednu vijest.
  const has = new Set(DATA.articles.flatMap(a => [a.source, ...(a.also || []).map(x => x.source)]));
  for (const s of DATA.sources.filter(s => has.has(s))) sel.append(el("option", { value: s }, s));
  sel.onchange = () => { state.source = sel.value; state.shown = STEP; render(); };
  document.getElementById("nav").append(sel);
  const q = document.getElementById("q");
  q.oninput = () => { state.q = q.value.trim(); state.shown = STEP; render(); };
  document.getElementById("home").onclick = e => {
    if (e.metaKey || e.ctrlKey) return;
    e.preventDefault(); q.value = ""; state.q = ""; state.source = ""; sel.value = ""; setTopic("Sve", true);
  };
}

// --- Svijetli / tamni način (automatski prema postavkama uređaja, ili ručno) ---
const ICONS = {
  light: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
  dark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>',
};
function setupTheme() {
  const btn = document.getElementById("theme");
  const dark = () => (document.documentElement.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")) === "dark";
  const paint = () => {
    btn.innerHTML = dark() ? ICONS.light : ICONS.dark;
    document.querySelector('meta[name="theme-color"]').content = dark() ? "#0b141c" : "#1968b3";
  };
  btn.onclick = () => {
    const t = dark() ? "light" : "dark";
    document.documentElement.dataset.theme = t;
    try { localStorage.setItem("themeChoice", JSON.stringify({ theme: t, until: autoTheme(new Date()).next.getTime() })); } catch (e) {}
    paint();
  };
  // Kad sunce zađe ili izađe dok je stranica otvorena, način se promijeni sam.
  const tick = () => { applyTheme(); paint(); };
  setInterval(tick, 60 * 1000);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) tick(); });
  paint();
}

// --- Trajekti (Jadrolinija) i ceste (vijesti o prometu + HAK) ---
// Jadrolinijine linije zadarskog područja (adrese s jadrolinija.hr/hr/putovanja).
const FERRY_LINES = [
  ["Zadar – Preko (Ugljan)", "zadar_-_preko"],
  ["Zadar (Gaženica) – Ošljak – Preko (Ugljan)", "zadar_gazenica_-_osljak_-_preko_ugljan"],
  ["Biograd – Tkon (Pašman)", "biograd_-_tkon_pasman"],
  ["Prizna – Žigljen (Pag)", "prizna_-_zigljen_pag"],
  ["Zadar (Gaženica) – Brbinj (Dugi otok)", "zadar_gazenica_-_brbinj_dugi_otok"],
  ["Zadar – Rivanj – Sestrunj – Zverinac – Božava – Brbinj", "zadar_-_rivanj_-_sestrunj_-_zverinac_-_bozava_-_brbinj"],
  ["Zadar – Mali Iž – Veli Iž – Mala Rava – Rava", "zadar_-_mali_iz-_veli_iz_-_mala_rava-_rava"],
  ["Zadar (Gaženica) – Bršanj (Iž) – Rava – Mala Rava", "zadar__gazenica_–_brsanj_iz_–_rava_–_mala_rava"],
  ["Zadar – Molat – Brgulje – Zapuntel – Ist", "zadar_-_molat_-_brgulje_-_zapuntel_-_ist"],
  ["Zadar (Gaženica) – Rivanj – Sestrunj – Zverinac – Molat – Ist", "zadar__gazenica_–_rivanj_–_sestrunj_–_zverinac_–_molat_–_ist"],
  ["Zadar – Silba – Mali Lošinj", "zadar_-_silba_-_mali_losinj_2"],
  ["Zadar (Gaženica) – Ist – Olib – Silba – Premuda – Mali Lošinj", "zadar_gazenica_-_ist_-_olib_-_silba_-_premuda_-_mali_losinj"],
];

function ferries() {
  const box = document.getElementById("ferries");
  const items = (DATA.info && DATA.info.Jadrolinija) || [];
  if (items.length) {
    const a = items[0];
    box.append(el("p", {}, el("a", { href: a.link, target: "_blank", rel: "noopener" }, a.title)));
    if (a.summary) box.append(el("p", { class: "small" }, a.summary));
  } else {
    box.append(el("p", { class: "small" }, "Trenutno nema obavijesti o prekidima."));
  }
  const lines = el("details", {}, el("summary", { class: "small" }, "Red plovidbe – zadarsko područje"));
  const ul = el("ul", { class: "small" });
  for (const [name, slug] of FERRY_LINES) {
    ul.append(el("li", {}, el("a", { href: "https://www.jadrolinija.hr/hr/putovanje/" + slug, target: "_blank", rel: "noopener" }, name)));
  }
  ul.append(el("li", {}, el("a", { href: "https://www.jadrolinija.hr/img/districts/zadar-okruzje-karta.pdf", target: "_blank", rel: "noopener" }, "Karta linija (PDF)")));
  lines.append(ul);
  box.append(lines);
}

function roads() {
  const box = document.getElementById("roads");
  // HAK-ov link je na vrhu da se na mobitelu vidi bez listanja unutar okvira.
  box.append(el("p", {}, el("a", { href: "https://m.hak.hr/stanje.asp?id=1", target: "_blank", rel: "noopener" }, el("b", {}, "Stanje na cestama (HAK) →"))));
  // Samo obavijesti o prometu i stanju na cestama (uključujući gradske ulice), bez policijskih kazni i sl.
  const since = Date.now() - 48 * 3600 * 1000;
  const re = /stanje na cest|regulacij\w* prometa|privremen\w* regulacij|zabran\w* prometa|obustav\w* prometa|zatvar\w* (?:za promet|cest|ulic|prometa|dionic)|zatvoren\w* (?:za promet|cest|ulic|dionic|autocest|most)|radovi na (?:cest|ulic|kolnik|raskrižj|dionic)|asfaltir|prometn\w* (?:nesreć|gužv|kolaps|zastoj|čep|regulacij|signalizacij|kaos|nezgod)|prometn\w* (?:nesreć|nezgod)|sudar\w* (?:dva|automobil|vozil|kamion|autobus)|slijetanj\w* (?:automobil|vozil|s cest)|zastoj\w*|kolon\w* vozila|gužv\w* na (?:cest|ulic|ulaz|izlaz)|(?:paški|paškog|masleničk\w*) most\w* (?:zatvoren|otvoren|za promet|samo za|ponovno)|(?:zatvoren|otvoren)\w* (?:paški|maslenički) most|autocest\w*|\bA1\b|\bD8\b|\bD106\b|kružn\w* tok|raskrižj\w*|semafor\w*|jednosmjern\w*|obilaznic\w*|pješačk\w* prijelaz|parkir\w* (?:mjest|zon|garaž)|nova cest|izgradnj\w* cest|rekonstrukcij\w* (?:cest|ulic|raskrižj)|upaljen\w* svjetl|zimsk\w* oprem|prometnic\w*|ometa promet|problem\w* u prometu|promet (?:otežan|usporen|zaustavljen|preusmjeren|odvija)/i;
  const hits = DATA.articles.filter(a => new Date(a.date) > since && re.test(a.title)).slice(0, 4);
  if (hits.length) {
    const ul = el("ul");
    for (const a of hits) ul.append(el("li", {}, el("a", { href: a.link, target: "_blank", rel: "noopener" }, a.title)));
    box.append(ul);
  } else {
    box.append(el("p", { class: "small" }, "Nema novih obavijesti o prometu u zadnja dva dana."));
  }
}

// --- Isključenja struje (HEP ODS, Elektra Zadar), danas i sutra ---
function power() {
  const box = document.getElementById("power");
  const url = "https://www.hep.hr/ods/bez-struje/19?dp=zadar";
  box.append(el("p", {}, el("a", { href: url, target: "_blank", rel: "noopener" }, el("b", {}, "Sva isključenja na HEP-u →"))));
  const all = DATA.info && DATA.info.power;
  if (!all) { box.append(el("p", { class: "small" }, "Popis trenutno nije dostupan.")); return; }
  // datumi kao na HEP-u (DD.MM.YYYY), po zagrebačkom vremenu; prazan dan ne smije pomaknuti sutra u "Danas"
  const hepDay = add => {
    const p = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Zagreb", day: "2-digit", month: "2-digit", year: "numeric" })
      .formatToParts(new Date(Date.now() + add * 864e5)).reduce((o, x) => (o[x.type] = x.value, o), {});
    return `${p.day}.${p.month}.${p.year}`;
  };
  const days = [hepDay(0), hepDay(1)];
  const row = r => el("li", {}, el("b", {}, r.place), ` ${r.time}`, r.unplanned ? el("span", { class: "kvar" }, "kvar") : null,
    r.street || r.note ? el("div", { class: "small" }, [r.street, r.note].filter(Boolean).join(" · ")) : null);
  const today = all.filter(r => r.day === days[0]);
  if (today.length) {
    const ul = el("ul", { class: "pw" });
    today.forEach(r => ul.append(row(r)));
    box.append(el("p", { class: "small" }, "Danas:"), ul);
  } else {
    box.append(el("p", { class: "small" }, "Danas nema najavljenih isključenja."));
  }
  const next = days[1] ? all.filter(r => r.day === days[1]) : [];
  if (next.length) {
    const ul = el("ul", { class: "pw" });
    next.forEach(r => ul.append(row(r)));
    box.append(el("details", {}, el("summary", { class: "small" }, `Sutra (${next.length})`), ul));
  }
}

// --- Reddit r/Zadar: najnovije teme zajednice ---
function reddit() {
  const box = document.getElementById("reddit");
  const all = DATA.info && DATA.info.reddit;
  if (!all || !all.length) { box.hidden = true; return; }
  const ul = el("ul", { class: "rd" });
  for (const r of all.slice(0, 5)) {
    const when = r.date ? ago(r.date) : "";
    ul.append(el("li", {}, el("a", { href: r.link, target: "_blank", rel: "noopener" }, r.title),
      when ? el("div", { class: "small" }, when) : null));
  }
  box.append(ul, el("p", {}, el("a", { href: "https://www.reddit.com/r/Zadar/", target: "_blank", rel: "noopener" }, el("b", {}, "Sve teme na r/Zadar →"))));
}

// --- Obavijesti Vodovoda Zadar (prekidi opskrbe vodom), zadnjih 10 dana ---
function water() {
  const box = document.getElementById("water");
  box.append(el("p", {}, el("a", { href: "https://www.vodovod-zadar.hr/obavijesti", target: "_blank", rel: "noopener" },
    el("b", {}, "Sve obavijesti Vodovoda →"))));
  const all = DATA.info && DATA.info.water;
  if (!all) { box.append(el("p", { class: "small" }, "Obavijesti trenutno nisu dostupne.")); return; }
  const since = Date.now() - 10 * 24 * 3600 * 1000;
  const recent = all.filter(n => new Date(n.day) > since).slice(0, 4);
  if (!recent.length) { box.append(el("p", { class: "small" }, "Nema novih obavijesti o prekidima.")); return; }
  const dayFmt = new Intl.DateTimeFormat("hr-HR", { day: "numeric", month: "numeric" });
  const ul = el("ul", { class: "pw" });
  // Duge obavijesti su skraćene; klik ih otvori cijele.
  for (const n of recent) {
    const li = el("li", { class: "wn" }, el("b", {}, dayFmt.format(new Date(n.day)) + " "), n.text);
    li.onclick = () => li.classList.toggle("open");
    ul.append(li);
  }
  box.append(ul);
}

// --- Autobusi: zadnje obavijesti Liburnije i njihovi vozni redovi ---
function buses() {
  const box = document.getElementById("buses");
  const lines = [["Gradske linije", "gradski-prijevoz"], ["Prigradske linije", "prigradski-prijevoz"], ["Međugradske linije", "medugradski-prijevoz"]];
  const p = el("p", {}, el("b", {}, "Vozni red: "));
  lines.forEach(([name, slug], i) => {
    if (i) p.append(" · ");
    p.append(el("a", { href: `https://liburnija-zadar.hr/${slug}/`, target: "_blank", rel: "noopener" }, name));
  });
  box.append(p);
  const since = Date.now() - 14 * 24 * 3600 * 1000;
  const src = (DATA.info && DATA.info.buses) || DATA.articles.filter(a => a.source === "Liburnija Zadar");
  const hits = src.filter(a => new Date(a.date) > since).slice(0, 3);
  if (hits.length) {
    const ul = el("ul");
    for (const a of hits) ul.append(el("li", {}, el("a", { href: a.link, target: "_blank", rel: "noopener" }, a.title)));
    box.append(ul);
  } else {
    box.append(el("p", { class: "small" }, "Nema novih obavijesti o linijama u zadnja dva tjedna."));
  }
}

// --- Vremenska prognoza (Open-Meteo, bez ključa) ---
const WMO = { 0: "vedro", 1: "pretežno vedro", 2: "djelomično oblačno", 3: "oblačno", 45: "magla", 48: "magla",
  51: "rosulja", 53: "rosulja", 55: "rosulja", 61: "slaba kiša", 63: "kiša", 65: "jaka kiša", 66: "ledena kiša", 67: "ledena kiša",
  71: "snijeg", 73: "snijeg", 75: "jak snijeg", 80: "pljuskovi", 81: "pljuskovi", 82: "jaki pljuskovi",
  95: "grmljavina", 96: "grmljavina s tučom", 99: "grmljavina s tučom" };
function windName(deg) {
  const names = ["tramontana", "bura", "levant", "jugo", "oštro", "lebić", "pulenat", "maestral"];
  return names[Math.round(((deg % 360) / 45)) % 8];
}
async function weather() {
  const box = document.getElementById("weather");
  const url = "https://api.open-meteo.com/v1/forecast?latitude=44.1194&longitude=15.2314" +
    "&current=temperature_2m,weather_code,wind_speed_10m,wind_gusts_10m,wind_direction_10m" +
    "&daily=weather_code,temperature_2m_max,temperature_2m_min,wind_gusts_10m_max&timezone=Europe%2FZagreb&forecast_days=3";
  try {
    const r = await fetch(url);
    if (!r.ok) throw new Error(r.status);
    const w = await r.json();
    const c = w.current, d = w.daily;
    box.textContent = "";
    box.append(el("h3", {}, "Vrijeme u Zadru"));
    const now = document.querySelector("#now b");
    if (now) now.textContent = `${Math.round(c.temperature_2m)}°C`;
    box.append(el("div", { class: "now" },
      el("span", { class: "temp" }, `${Math.round(c.temperature_2m)}°C`),
      el("span", {}, WMO[c.weather_code] || "")));
    box.append(el("p", { class: "small" }, `${windName(c.wind_direction_10m)} ${Math.round(c.wind_speed_10m)} km/h, udari do ${Math.round(c.wind_gusts_10m)} km/h`));
    const days = el("div", { class: "days" });
    const dayFmt = new Intl.DateTimeFormat("hr-HR", { weekday: "short" });
    d.time.forEach((t, i) => days.append(el("span", {},
      `${i ? dayFmt.format(new Date(t)) : "danas"} ${Math.round(d.temperature_2m_min[i])}–${Math.round(d.temperature_2m_max[i])}°`)));
    box.append(days);
    const maxGust = Math.max(c.wind_gusts_10m, ...d.wind_gusts_10m_max.slice(0, 2));
    if (maxGust >= 70) {
      box.append(el("div", { class: "warn" },
        `Jak vjetar: udari do ${Math.round(maxGust)} km/h. Mogu biti zatvoreni Paški most, Maslenička cesta i A1 za neka vozila, a trajekti u prekidu.`));
    }
  } catch (e) {
    box.querySelector("p").textContent = "Prognoza trenutno nije dostupna.";
    const now = document.getElementById("now");
    if (now) now.remove();
  }
}

// --- Letovi (popis Zračne luke Zadar, osvježava se sa stranicom svakih 15 minuta) ---
const FLIGHT_STATUS = { "Landed": "sletio", "Departed": "poletio", "Delayed": "kasni", "Cancelled": "otkazan",
  "Canceled": "otkazan", "Boarding": "ukrcaj", "Gate closed": "izlaz zatvoren", "Final call": "zadnji poziv",
  "Check-in": "prijava", "Diverted": "preusmjeren", "Expected": "očekuje se", "Airborne": "u zraku" };
function flights() {
  const box = document.getElementById("flights");
  // popis zračne luke ujutro još drži jučerašnje letove: ostaju samo današnji (po zagrebačkom datumu)
  const ymd = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Zagreb" }).format(new Date());
  const raw = (DATA.info && DATA.info.flights) || null;
  const all = raw && raw.filter(f => (f.time || "").slice(0, 10) === ymd);
  const hm = s => s ? s.slice(11, 16) : "";
  if (!all || !all.length) {
    box.append(el("p", { class: "small" }, all ? "Na popisu zračne luke još nema današnjih letova." : "Popis letova trenutno nije dostupan."));
  }
  for (const [dir, label] of [["dolazak", "Dolasci"], ["odlazak", "Odlasci"]]) {
    const list = (all || []).filter(f => f.dir === dir);
    if (!list.length) continue;
    box.append(el("p", { class: "small" }, el("b", {}, label)));
    const ul = el("ul", { class: "flights" });
    for (const f of list) {
      const changed = f.est && f.est !== f.time && !f.act ? ` (očekivano ${hm(f.est)})` : "";
      const st = FLIGHT_STATUS[f.status] || f.status.toLowerCase();
      const city = f.via ? `${f.city} (međuslijetanje: ${f.via})` : f.city;
      ul.append(el("li", {}, el("b", {}, hm(f.time)), ` ${city} · ${f.flight}${changed}`,
        st ? el("span", { class: "st" }, ` · ${st}${f.act ? " " + hm(f.act) : ""}`) : null));
    }
    box.append(ul);
  }
  box.append(el("p", { class: "small" }, `Stanje u ${hmFmt.format(new Date(DATA.updated))}. `,
    el("a", { href: "https://www.zadar-airport.hr/pregled-letova/?sekcija=putnici", target: "_blank", rel: "noopener" }, "Uživo na stranici zračne luke →")));
}

// --- Newsletter: jutarnji pregled vijesti e-mailom (Buttondown ga slaže iz feed.xml) ---
let subscribed = false;
try { subscribed = localStorage.getItem("newsletter") === "1"; } catch (e) {}
function newsletter() {
  const user = DATA.settings && DATA.settings.newsletter;
  if (!user) return "";
  const box = el("section", { class: "news", "aria-label": "Newsletter" },
    el("div", {}, el("h3", {}, "Jutarnji pregled vijesti iz Zadra"),
      el("p", {}, "Najvažnije vijesti iz Zadra i županije svako jutro u tvom e-mailu. Besplatno, odjava jednim klikom.")));
  if (subscribed) {
    box.append(el("p", { class: "ok" }, "Prijavljen si. Provjeri e-mail i potvrdi prijavu."));
    return box;
  }
  const form = el("form", { action: `https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(user)}`,
    method: "post", target: "_blank" },
    el("input", { type: "email", name: "email", required: "", placeholder: "tvoj@email.hr", "aria-label": "E-mail adresa", autocomplete: "email" }),
    el("input", { type: "hidden", name: "tag", value: "web" }),
    el("button", { type: "submit" }, "Prijavi me"));
  form.onsubmit = () => {
    subscribed = true;
    try { localStorage.setItem("newsletter", "1"); } catch (e) {}
    setTimeout(() => form.replaceWith(el("p", { class: "ok" }, "Hvala! Provjeri e-mail i potvrdi prijavu.")), 50);
  };
  box.append(form);
  return box;
}

function analytics() {
  const code = DATA.settings && DATA.settings.goatcounter;
  if (!code) return;
  const s = el("script", { async: "", src: "https://gc.zgo.at/count.js", "data-goatcounter": `https://${code}.goatcounter.com/count` });
  document.body.append(s);
}

// Google Analytics se učitava tek kad posjetitelj prihvati kolačiće (GDPR).
function googleAnalytics() {
  const id = DATA.settings && DATA.settings.google_analytics;
  if (!id) return;
  let choice = null;
  try { choice = localStorage.getItem("cookies"); } catch (e) {}
  const load = () => {
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag("js", new Date());
    gtag("config", id);
    document.head.append(el("script", { async: "", src: `https://www.googletagmanager.com/gtag/js?id=${id}` }));
  };
  if (choice === "yes") return load();
  if (choice === "no") return;
  const save = v => { try { localStorage.setItem("cookies", v); } catch (e) {} bar.remove(); if (v === "yes") load(); };
  const no = el("button", { type: "button", class: "no" }, "Ne");
  const yes = el("button", { type: "button", class: "yes" }, "Prihvaćam");
  no.onclick = () => save("no");
  yes.onclick = () => save("yes");
  const bar = el("div", { class: "cookies", role: "dialog", "aria-label": "Kolačići" },
    el("p", {}, "Koristimo Google Analytics kolačiće da vidimo koliko ljudi čita stranicu. Pristaješ?"),
    el("div", {}, no, yes));
  document.body.append(bar);
}

// Instalirana aplikacija (ikona na početnom zaslonu): članci se otvaraju u istom prozoru,
// pa tipka Natrag uvijek vraća na idassa.click (s novom karticom Android je slagao stare članke
// jedan na drugi i nije bilo puta natrag). Položaj na popisu pamti se i vraća po povratku.
const AWAY = 10 * 60e3;
if ("scrollRestoration" in history) history.scrollRestoration = "manual";
function appMode() {
  const app = matchMedia("(display-mode: standalone)").matches || navigator.standalone;
  let saved = null;
  try { saved = JSON.parse(sessionStorage.getItem("pos") || "null"); } catch (e) {}
  if (saved && saved.path === location.pathname && Date.now() - saved.t < AWAY) {
    if (saved.shown > state.shown) { state.shown = saved.shown; list(); }
    requestAnimationFrame(() => scrollTo(0, saved.y));
  }
  if (!app) return;
  // U aplikaciji s početnog zaslona članak se otvara u zasebnom pregledniku (na Androidu s ✕ gore lijevo),
  // jer neki portali na svojoj stranici dodaju lažne korake "natrag" pa se gumbom natrag ne bi moglo vratiti ovamo.
  // Pamtimo položaj na popisu da se vratimo na isto mjesto.
  document.addEventListener("click", e => {
    const a = e.target.closest && e.target.closest('a[target="_blank"]');
    if (!a) return;
    try { sessionStorage.setItem("pos", JSON.stringify({ path: location.pathname, y: scrollY, shown: state.shown, t: Date.now() })); } catch (err) {}
  });
}

// Gumb za dijeljenje na kartici: na mobitelu otvara izbornik za dijeljenje, inače kopira link.
const SHARE_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>';
function toast(t) {
  document.querySelectorAll(".toast").forEach(x => x.remove());
  const e = el("div", { class: "toast", role: "status" }, t);
  document.body.append(e);
  setTimeout(() => e.remove(), 2200);
}
function shareBtn(a) {
  const b = el("button", { type: "button", class: "shr", "aria-label": "Podijeli vijest", title: "Podijeli" });
  b.innerHTML = SHARE_SVG;
  b.addEventListener("click", async e => {
    e.preventDefault(); e.stopPropagation();
    const text = `${a.title}\n\nViše vijesti iz Zadra: idassa.click`;
    if (navigator.share) { try { await navigator.share({ title: a.title, text, url: a.link }); } catch (err) {} return; }
    try { await navigator.clipboard.writeText(`${a.title}\n${a.link}\n\nViše vijesti iz Zadra: https://idassa.click`); toast("Link je kopiran"); }
    catch (err) { window.open(`https://wa.me/?text=${encodeURIComponent(a.title + " " + a.link)}`, "_blank", "noopener"); }
  });
  return b;
}

// Traka "Dodaj na početni zaslon" (samo mobitel, ne u instaliranoj aplikaciji, najviše jednom u 14 dana).
let installEvt = null;
addEventListener("beforeinstallprompt", e => { e.preventDefault(); installEvt = e; });
addEventListener("appinstalled", () => { try { localStorage.setItem("installHide", "9999999999999"); } catch (e) {} document.querySelector(".install")?.remove(); });
function installBar() {
  const app = matchMedia("(display-mode: standalone)").matches || navigator.standalone;
  if (app || !matchMedia("(max-width: 820px)").matches) return;
  let hide = 0;
  try { hide = +localStorage.getItem("installHide") || 0; } catch (e) {}
  if (Date.now() < hide) return;
  const ios = /iphone|ipad|ipod/i.test(navigator.userAgent);
  let shown = false;
  const show = () => {
    if (shown || document.querySelector(".cookies")) return;
    shown = true;
    removeEventListener("scroll", onScroll);
    const close = () => { try { localStorage.setItem("installHide", String(Date.now() + 14 * 864e5)); } catch (e) {} bar.remove(); };
    const x = el("button", { type: "button", class: "x", "aria-label": "Zatvori" }, "×");
    x.onclick = close;
    const tip = installEvt ? "Vijesti iz Zadra jednim dodirom, kao aplikacija."
      : ios ? "Stisni ikonu Dijeli (kvadrat sa strelicom), pa „Dodaj na početni zaslon“."
      : "U izborniku preglednika (⋮) odaberi „Dodaj na početni zaslon“.";
    const add = installEvt ? el("button", { type: "button", class: "add" }, "Dodaj") : null;
    if (add) add.onclick = async () => { installEvt.prompt(); try { const r = await installEvt.userChoice; if (r.outcome === "accepted") close(); } catch (e) {} };
    const bar = el("div", { class: "install", role: "dialog", "aria-label": "Dodaj na početni zaslon" },
      el("img", { src: BASE + "icon-192.png", alt: "" }),
      el("div", {}, el("b", {}, "Dodaj idassa.click na početni zaslon"), tip), add, x);
    document.body.append(bar);
  };
  const onScroll = () => { if (scrollY > 1400) show(); };
  addEventListener("scroll", onScroll, { passive: true });
  setTimeout(show, 25e3);
}

// Gumb "Na vrh" kad se dođe do podnožja
function toTop() {
  const f = document.querySelector("footer");
  if (!f || !("IntersectionObserver" in window)) return;
  const b = el("button", { type: "button", class: "totop", "aria-label": "Natrag na vrh stranice" }, "Na vrh");
  b.insertAdjacentHTML("afterbegin", '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>');
  b.addEventListener("click", () => scrollTo({ top: 0, behavior: "smooth" }));
  document.body.append(b);
  new IntersectionObserver(es => b.classList.toggle("on", es[0].isIntersecting)).observe(f);
}

// Kontakt za dojave (site.json "email"): gumb u kutu i adresa u podnožju
function contact() {
  const m = DATA.settings && DATA.settings.email;
  if (!m) return;
  const href = `mailto:${m}?subject=${encodeURIComponent("Upit za idassa.click")}`;
  const f = document.getElementById("f-mail");
  f.append("Kontakt: ", el("a", { href }, m));
  f.hidden = false;
  if (DATA.settings.whatsapp) return;  // WhatsApp gumb ima prednost u kutu
  const a = el("a", { class: "tip", href, "aria-label": "Kontaktiraj nas e-mailom" }, el("span", {}, "Kontaktiraj nas"));
  a.insertAdjacentHTML("afterbegin", '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>');
  document.body.append(a);
}

// Plutajući gumb za WhatsApp (dojave i poruke uredništvu), broj iz site.json "whatsapp"
function whatsapp() {
  const n = DATA.settings && DATA.settings.whatsapp;
  if (!n) return;
  const text = encodeURIComponent("Pozdrav idassa.click! ");
  const a = el("a", { class: "wa", href: `https://wa.me/${n}?text=${text}`, target: "_blank", rel: "noopener",
    "aria-label": "Pošalji poruku na WhatsApp" }, el("span", {}, "Pošalji dojavu"));
  a.insertAdjacentHTML("beforeend", '<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3Zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4a10.4 10.4 0 0 1-1.6-5.6C5.2 10 10 5.3 16 5.3S26.8 10 26.8 15.8 22 26.4 16 26.4Zm5.9-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.8 5 .8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.4Z"/></svg>');
  document.body.append(a);
}

const today = new Intl.DateTimeFormat("hr-HR", { weekday: "long", day: "numeric", month: "long" }).format(new Date());
document.getElementById("sub").textContent =
  `${today.charAt(0).toUpperCase() + today.slice(1)} · ažurirano u ${hmFmt.format(new Date(DATA.updated))}`;
history.replaceState({ topic: state.topic }, "");
setupTheme();
masthead();
footer();
setupTools();
setTopic(state.topic, false);
appMode();
ferries();
flights();
roads();
power();
water();
reddit();
buses();
weather();
analytics();
googleAnalytics();
whatsapp();
contact();
toTop();
installBar();
if ("serviceWorker" in navigator) navigator.serviceWorker.register(BASE + "sw.js").catch(() => {});

// Stranica uvijek pokazuje najnovije izdanje: pri svakom otvaranju, povratku na karticu (npr. Chrome
// otvoren od sinoć) i svakih 5 minuta provjerimo poslužitelj i, ako ima novije, učitamo ga.
// Učitava se s ?r=… da preglednik ne posluži spremljenu kopiju; oznaka se poslije makne iz adrese.
if (/[?&]r=\d/.test(location.search)) history.replaceState(history.state, "", location.pathname + location.hash);
let lastCheck = 0;
async function checkFresh() {
  if (document.visibilityState !== "visible" || Date.now() - lastCheck < 20e3) return;
  lastCheck = Date.now();
  try {
    const r = await fetch(location.pathname + "?v=" + Date.now(), { cache: "no-store" });
    const m = (await r.text()).match(/"updated": "([^"]+)"\}/);
    if (m && new Date(m[1]) > new Date(DATA.updated)) {
      // zaštita od petlje: najviše jedno osvježavanje u minuti
      let last = 0;
      try { last = +sessionStorage.getItem("reloadAt") || 0; sessionStorage.setItem("reloadAt", Date.now()); } catch (e) {}
      if (Date.now() - last < 60e3) return;
      try { sessionStorage.setItem("pos", JSON.stringify({ path: location.pathname, y: scrollY, shown: state.shown, t: Date.now() })); } catch (e) {}
      location.replace(location.pathname + "?r=" + Date.now() + location.hash);
    }
  } catch (e) {}
}
// Povratak na stranicu nakon duže odsutnosti (AWAY, npr. aplikacija otvorena od jučer): uvijek
// učitaj najnovije izdanje i kreni od vrha (Stipe, 2026-11-19). Kratki povratak s članka čuva položaj.
let hiddenAt = 0;
function freshTop() {
  try { sessionStorage.removeItem("pos"); } catch (e) {}
  location.replace(location.pathname + "?r=" + Date.now());
}
function awayCheck() {
  if (document.hidden) { hiddenAt = hiddenAt || Date.now(); return false; }
  const away = hiddenAt && Date.now() - hiddenAt > AWAY;
  hiddenAt = 0;
  if (away) freshTop();
  return away;
}
document.addEventListener("visibilitychange", () => { if (!awayCheck()) checkFresh(); });
addEventListener("pagehide", () => { hiddenAt = hiddenAt || Date.now(); });
addEventListener("pageshow", e => { if (e.persisted && !awayCheck()) { lastCheck = 0; checkFresh(); } });
addEventListener("focus", checkFresh);
setInterval(checkFresh, 5 * 60e3);
checkFresh();
</script>
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "79a0c00648ae4f328af3ef589b0d24fd"}'></script></body>
